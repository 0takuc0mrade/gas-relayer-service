# Relayer Wallet (the "God Key"). NEVER commit a real key.
PRIVATE_KEY=

# --- optional overrides ----------------------------------------------------
# Public node. Used for `eth_call` (the dry run), the chain id, and receipts.
#RPC_URL=http://127.0.0.1:8545

# Private orderflow endpoint (Flashbots relay, a builder, a second node...).
# When set, the relayer STILL simulates against RPC_URL, but broadcasts only
# here, so the signed transaction never enters the public mempool.
#PRIVATE_RPC_URL=https://relay.flashbots.net
#FLASHBOTS_RPC_URL=https://relay.flashbots.net

# Trusted forwarder every intent is relayed to. Bound into the EIP-712 domain,
# so changing it invalidates every client signature.
#FORWARDER_ADDRESS=0x0000000000000000000000000000000000000000

# API bind address. Use 127.0.0.1, never `localhost`: on macOS `localhost`
# resolves to ::1 first and the IPv4-only listener looks silently broken.
#BIND_ADDR=127.0.0.1:3000

# EIP-712 domain. Both values are part of the domain separator.
#EIP712_NAME=HardenedRelayer
#EIP712_VERSION=1

# Defensive limits.
#MAX_SEEN_ENTRIES=100000   # bound on the used-signature registry (memory)
#QUEUE_CAPACITY=100        # intents in flight before 503 back-pressure
#AWAIT_RECEIPTS=1          # 0 = fire and forget, 1 = measure gas burned on reverts

# --- lab switches (Part 1: show the loss, then show it stopped) ------------
#DRY_RUN=1                 # 0 = skip eth_call and buy failing transactions like Day 3
#GAS_LIMIT=100000          # explicit gas limit; this also skips eth_estimateGas, whose
                           # failure would otherwise hide the loss from you

# Simulator target only (src/bin/simulator.rs).
#RELAYER_URL=http://127.0.0.1:3000
